# Copy this file to .env.local (local dev) and set the same names in Vercel > Project > Settings > Environment Variables.
# Get a key at https://resend.com/api-keys

RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where the messages are delivered. With Resend's free test sender (onboarding@resend.dev) this must be the
# email address of your Resend account. To send to any address, verify your own domain in Resend first.
CONTACT_TO_EMAIL=divyabharat1407@gmail.com

# Optional: a sender on your verified domain, e.g. "Portfolio <contact@yourdomain.com>"
# CONTACT_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>
